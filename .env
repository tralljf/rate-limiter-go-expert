# Porta HTTP da aplicação
SERVER_PORT=8080

# Estratégia de persistência: redis | memory
RATE_LIMIT_STORAGE=redis

# Máximo de requisições por janela para cada IP
RATE_LIMIT_IP=10

# Limites por token (header API_KEY), no formato token:limite separados por vírgula.
# O limite do token sobrepõe o do IP.
RATE_LIMIT_TOKENS=abc123:100,def456:50

# Limite para tokens não listados acima. 0 = token desconhecido é ignorado e vale o limite por IP.
RATE_LIMIT_TOKEN_DEFAULT=0

# Tamanho da janela de contagem (1s = requisições por segundo)
RATE_LIMIT_WINDOW=1s

# Tempo de bloqueio após exceder o limite (formato Go: 300s, 5m, 1h)
RATE_LIMIT_BLOCK_DURATION=5m

# Use o primeiro IP de X-Forwarded-For/X-Real-IP (somente atrás de um proxy confiável)
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Conexão com o Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
